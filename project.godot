; Engine configuration file.
config_version=5

[application]

config/name="Little Sword - Tactical Board RPG"
run/main_scene="res://src/scenes/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
BoardGrid="*res://src/core/board_grid.gd"
DiceManager="*res://src/autoload/dice_manager.gd"
TurnManager="*res://src/autoload/turn_manager.gd"
CombatSystem="*res://src/autoload/combat_system.gd"
InventorySystem="*res://src/autoload/inventory_system.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
